{
  "name": "sprang",
  "version": "0.3.0",
  "description": "Knowledge graph platform for instant codebase comprehension — git history, structural health, risk scoring, and architectural tours for any project",
  "author": { "name": "FavioVazquez" },
  "homepage": "https://github.com/faviovazquez/sprang",
  "repository": "https://github.com/faviovazquez/sprang",
  "license": "MIT",
  "keywords": [
    "knowledge-graph",
    "codebase-analysis",
    "architecture",
    "git-history",
    "risk-scoring",
    "onboarding",
    "dashboard"
  ],
  "skills": ["./skills"],
  "mcpServers": {
    "sprang": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/packages/mcp/dist/server.js"],
      "env": { "SPRANG_ROOT": "${workspaceFolder}" }
    }
  }
}
